APP_NAME="Manager Library"
APP_ENV=production
# Generar con: php artisan key:generate --show   (no versionar el valor real)
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Fechas siempre en UTC (D11)
APP_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Registros a stderr, sin cuerpos de peticiones ni contraseñas (RNF-3)
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# PostgreSQL 16. En docker compose el host es `db`; en local, 127.0.0.1.
# El esquema `library` lo crea la primera migración (D25); el search_path
# incluye `public` porque ahí vive la tabla de control `migrations`.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=
DB_SEARCH_PATH=library,public

# Sin tablas de sesión, caché ni colas: el modelo de datos tiene seis tablas (D14)
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Contraseñas con BCrypt factor 12 (plan D-09)
BCRYPT_ROUNDS=12

# JWT HS256 de 8 horas (D4). Mínimo 32 caracteres aleatorios.
JWT_SECRET=
JWT_TTL_SECONDS=28800

# Administrador inicial: lo crea `php artisan library:ensure-admin` (D3)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Único origen permitido por CORS: el del frontend (api-contract §4)
CORS_ORIGIN=http://localhost:5173

# Carpeta de portadas (CoverStorage)
COVERS_DIR=storage/app/covers
