{
    "name": "sena/manager-library-api",
    "type": "project",
    "description": "API de Manager Library (Laravel): catálogo, socios y préstamos de una biblioteca.",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-pdo_pgsql": "*",
        "firebase/php-jwt": "6.10.1",
        "laravel/framework": "11.31.0"
    },
    "require-dev": {
        "pestphp/pest": "3.5.1",
        "pestphp/pest-plugin-laravel": "3.0.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
